# Discord
DISCORD_TOKEN=your-bot-token-here

# Chain (EVM JSON-RPC)
RPC_URL=http://192.168.1.101:8545
CHAIN_ID=8136
# Private key of the faucet/bot hot wallet (0x... hex). Use a DEDICATED wallet
# with only faucet funds — never your main wallet.
PRIVATE_KEY=0xyour-private-key-here
# Flat gas price is set so a standard 21000-gas transfer costs this much total
GAS_FEE_AMOUNT=0.0001

# Coin / address settings
BECH32_PREFIX=steem
COIN_SYMBOL=STEEM

# Faucet — anyone can claim; ROLE_FAUCET holders get the bigger amount
FAUCET_AMOUNT_DEFAULT=1000
FAUCET_AMOUNT_VALIDATOR=5000
# Hours between claims, per Discord account AND per address (resets daily by default)
FAUCET_COOLDOWN_HOURS=24
# Claims are stored in faucet.db (SQLite). Delete a row to reset a claim early.

# Discord role names. !wallet, !balance, !validators, !faucet are open to everyone.
# Role that gets the bonus faucet amount:
ROLE_FAUCET=Validators
# Role required for all other commands (!hi, !ping, ...):
ROLE_GENERAL=EVM Assistant

# Channel name (without #) where new members are welcomed
GREETING_CHANNEL=greetings

# Cosmos REST API (gRPC-gateway, usually port 1317) for !validators and !status.
# Defaults to the same host as RPC_URL on port 1317 — only set this if
# your Cosmos REST endpoint lives on a different host.
# COSMOS_REST_URL=http://192.168.1.101:1317

# Blockscout explorer API, used by !status for block time / tx / address counts
BLOCKSCOUT_API_URL=https://evmscan.steemscanner.com

# Public web faucet endpoint (POST /faucet), e.g. served behind
# https://faucet.steemscanner.com — one claim per address, ever, no API key.
# Port the HTTP server listens on inside the container/process:
WEB_FAUCET_PORT=3000
# Fixed amount sent per address (independent of the Discord !faucet amounts):
WEB_FAUCET_AMOUNT=5000
# Access-Control-Allow-Origin sent on responses. Set to your site's origin
# (e.g. https://faucet.steemscanner.com) to restrict browser callers, or
# leave as * to allow any origin:
WEB_FAUCET_CORS_ORIGIN=*
# Per-IP rate limit: max requests per WEB_FAUCET_RATE_LIMIT_WINDOW_MS
WEB_FAUCET_RATE_LIMIT_MAX=10
WEB_FAUCET_RATE_LIMIT_WINDOW_MS=3600000
# Set to true only if this is deployed behind a reverse proxy you trust to
# set X-Forwarded-For — otherwise callers could spoof it to dodge rate limiting.
WEB_FAUCET_TRUST_PROXY=false

# Steem testnet account creation (!create testnet <username>)
TESTNET_RPC_URL=https://testnet.blazeapps.org
TESTNET_CHAIN_ID=18dcf0a285365fc58b71f18b3d3fec954aa0c141c44e4e5cb4cf777b9eab274e
TESTNET_ADDRESS_PREFIX=TST
TESTNET_CREATOR_ACCOUNT=initminer
# initminer's active private key (WIF, starts with "5"). Use a DEDICATED
# testnet key — never a mainnet Steem active key.
TESTNET_ACTIVE_KEY=your-initminer-active-private-key
